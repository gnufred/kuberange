#!/usr/bin/env python3
"""Cache checksum-pinned upstream release assets for offline VM provisioning."""

import argparse
import hashlib
import json
from pathlib import Path
import shutil
import tempfile
from urllib.request import urlopen

LAB = Path(__file__).resolve().parent.parent
MANIFEST = LAB / 'config/binaries.json'
CACHE = LAB / '.lfs/binaries'


def matches(path, expected):
    if not path.is_file():
        return False
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest() == expected


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='Verify the cache without downloading')
    args = parser.parse_args()

    try:
        assets = json.loads(MANIFEST.read_text())['upstream_binaries']
        for asset in assets.values():
            path = CACHE / asset['file']
            expected = asset['sha256']
            if not matches(path, expected):
                if args.check:
                    raise ValueError(f'Missing or incorrect release asset: {path}')
                CACHE.mkdir(parents=True, exist_ok=True)
                with tempfile.TemporaryDirectory(dir=CACHE) as directory:
                    temporary = Path(directory) / path.name
                    with urlopen(asset['url'], timeout=120) as source, temporary.open('wb') as output:
                        shutil.copyfileobj(source, output)
                    if not matches(temporary, expected):
                        raise ValueError(f'Upstream checksum mismatch: {path.name}')
                    temporary.replace(path)
            print(f'Verified {path.name}')
    except (OSError, ValueError) as error:
        parser.exit(1, f'cache-binaries: {error}\n')


if __name__ == '__main__':
    main()
